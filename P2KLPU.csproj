<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Rename binary/assembly to match the tool name -->
    <AssemblyName>P2KLPU</AssemblyName>
    <RootNamespace>P2KLPU</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep excluding test sources from the main project build. -->
    <Compile Remove="P2KLPU.Tests\**\*.cs" />
    <None Remove="P2KLPU.Tests\**\*" />

    <!-- Back-compat (in case an old folder name exists locally). -->
    <Compile Remove="P2PP.Poc.Tests\**\*.cs" />
    <None Remove="P2PP.Poc.Tests\**\*" />
  </ItemGroup>
</Project>
